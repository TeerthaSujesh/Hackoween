# Application Settings
APP_NAME="Trend Doctor"
APP_ENV="development"
DEBUG=true

# Database Settings (SQLite for local dev)
DATABASE_URL="sqlite:///./trend_doctor.db"

# Authentication & Security
JWT_SECRET_KEY="dev-insecure-secret-key-change-in-production-1234567890"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider (Vision fallback for scanned PDFs & patient-friendly explainers)
OPENAI_API_KEY="your-openai-api-key-here"

# Storage Settings
STORAGE_DIR="storage/uploads"

